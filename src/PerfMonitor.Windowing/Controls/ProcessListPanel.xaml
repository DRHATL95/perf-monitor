<UserControl x:Class="PerfMonitor.Windowing.Controls.ProcessListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <StackPanel>
        <!-- Header row (sticky above the list) -->
        <Grid Margin="10,4,10,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HeaderTitle"
                       Grid.Column="0"
                       Text="Top CPU"
                       FontSize="10"
                       Opacity="0.55"
                       Foreground="White"
                       FontWeight="Medium"/>
            <TextBlock x:Name="HeaderValue"
                       Grid.Column="1"
                       Text=""
                       FontSize="10"
                       Opacity="0.55"
                       Foreground="White"
                       FontWeight="Medium"
                       HorizontalAlignment="Right"/>
        </Grid>

        <!-- Process rows -->
        <ItemsControl x:Name="ProcessList" Margin="10,0,10,6">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,1" Background="Transparent" MouseRightButtonUp="OnRowRightClick">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="End task" Click="OnEndTaskClick"/>
                            </ContextMenu>
                        </Grid.ContextMenu>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Display}"
                                   FontSize="11"
                                   Foreground="White"
                                   Opacity="0.9"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding FormattedValue}"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="{Binding AccentBrush}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Footer note for deferred metrics -->
        <TextBlock x:Name="DeferredNote"
                   Margin="10,0,10,6"
                   FontSize="10"
                   Opacity="0.5"
                   Foreground="White"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
